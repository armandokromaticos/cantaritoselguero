generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// USERS
// ============================================

model User {
  id        String   @id @default(uuid())
  authId    String?  @unique @map("auth_id")
  email     String   @unique
  name      String
  phone     String?
  role      Role     @default(USER)
  standId   String?  @map("stand_id")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stand     Stand?   @relation(fields: [standId], references: [id])

  @@map("users")
}

enum Role {
  USER
  ADMIN
  STAND_OPERATOR
}

// ============================================
// STANDS
// ============================================

model Stand {
  id          String   @id @default(uuid())
  name        String
  description String?
  image       String?
  location    String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  operators   User[]
  products    Product[]

  @@map("stands")
}

// ============================================
// PRODUCTS
// ============================================

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  basePrice   Decimal  @map("base_price") @db.Decimal(10, 2)
  image       String?
  stock       Int?
  isActive    Boolean  @default(true) @map("is_active")
  standId     String?  @map("stand_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  stand          Stand?                 @relation(fields: [standId], references: [id])
  sizes          ProductSize[]
  modifierGroups ProductModifierGroup[]

  @@map("products")
}

model ProductSize {
  id        String  @id @default(uuid())
  productId String  @map("product_id")
  name      String
  price     Decimal @db.Decimal(10, 2)
  sortOrder Int     @default(0) @map("sort_order")
  isDefault Boolean @default(false) @map("is_default")
  isActive  Boolean @default(true) @map("is_active")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_sizes")
}

model ProductModifierGroup {
  id          String  @id @default(uuid())
  productId   String  @map("product_id")
  name        String
  description String?
  minSelect   Int     @default(0) @map("min_select")
  maxSelect   Int     @default(1) @map("max_select")
  sortOrder   Int     @default(0) @map("sort_order")
  isRequired  Boolean @default(false) @map("is_required")

  product   Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  modifiers ProductModifier[]

  @@map("product_modifier_groups")
}

model ProductModifier {
  id              String  @id @default(uuid())
  groupId         String  @map("group_id")
  name            String
  priceAdjustment Decimal @default(0) @map("price_adj") @db.Decimal(10, 2)
  isDefault       Boolean @default(false) @map("is_default")
  isActive        Boolean @default(true) @map("is_active")
  sortOrder       Int     @default(0) @map("sort_order")

  group ProductModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@map("product_modifiers")
}