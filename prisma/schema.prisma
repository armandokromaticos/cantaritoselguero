generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// USERS
// ============================================

model User {
  id        String   @id @default(uuid())
  authId    String?  @unique @map("auth_id")
  email     String   @unique
  name      String
  phone     String?
  role      Role     @default(USER)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stands       StandOperator[]
  orders       Order[]
  deliveries   OrderItemDelivery[] @relation("deliveries")
  couponUsages CouponUsage[]

  @@map("users")
}

enum Role {
  USER
  ADMIN
  STAND_OPERATOR
  CATALOG_MANAGER
}

// ============================================
// STANDS
// ============================================

model Stand {
  id          String   @id @default(uuid())
  name        String
  description String?
  image       String?
  location    String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  operators   StandOperator[]
  products    Product[]
  catalog     StandProduct[]
  orders      Order[]
  orderItems  OrderItem[]
  deliveries  OrderItemDelivery[]

  @@map("stands")
}

model StandOperator {
  standId   String   @map("stand_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  stand Stand @relation(fields: [standId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@id([standId, userId])
  @@map("stand_operators")
}

model StandProduct {
  standId   String   @map("stand_id")
  productId String   @map("product_id")
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  stand   Stand   @relation(fields: [standId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([standId, productId])
  @@map("stand_products")
}

// ============================================
// PRODUCTS
// ============================================

model Product {
  id            String   @id @default(uuid())
  nameEs        String   @map("name_es")
  nameEn        String?  @map("name_en")
  descriptionEs String?  @map("description_es")
  descriptionEn String?  @map("description_en")
  basePrice     Decimal  @map("base_price") @db.Decimal(10, 2)
  image         String?
  stock         Int?
  isActive      Boolean  @default(true) @map("is_active")
  standId       String?  @map("stand_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  stand          Stand?                 @relation(fields: [standId], references: [id])
  standCatalog   StandProduct[]
  sizes          ProductSize[]
  modifierGroups ProductModifierGroup[]
  comboItems     ComboItem[]
  orderItems     OrderItem[]
  tags           ProductTag[]
  sectionItems   SectionItem[]

  @@map("products")
}

model ProductSize {
  id        String  @id @default(uuid())
  productId String  @map("product_id")
  nameEs    String  @map("name_es")
  nameEn    String? @map("name_en")
  price     Decimal @db.Decimal(10, 2)
  stock     Int?
  sortOrder Int     @default(0) @map("sort_order")
  isDefault Boolean @default(false) @map("is_default")
  isActive  Boolean @default(true) @map("is_active")

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@map("product_sizes")
}

model ProductModifierGroup {
  id            String  @id @default(uuid())
  productId     String  @map("product_id")
  nameEs        String  @map("name_es")
  nameEn        String? @map("name_en")
  descriptionEs String? @map("description_es")
  descriptionEn String? @map("description_en")
  minSelect     Int     @default(0) @map("min_select")
  maxSelect     Int     @default(1) @map("max_select")
  sortOrder     Int     @default(0) @map("sort_order")

  product   Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  modifiers ProductModifier[]

  @@map("product_modifier_groups")
}

model ProductModifier {
  id              String  @id @default(uuid())
  groupId         String  @map("group_id")
  nameEs          String  @map("name_es")
  nameEn          String? @map("name_en")
  priceAdjustment Decimal @default(0) @map("price_adj") @db.Decimal(10, 2)
  isDefault       Boolean @default(false) @map("is_default")
  isActive        Boolean @default(true) @map("is_active")
  sortOrder       Int     @default(0) @map("sort_order")

  group              ProductModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  orderItemModifiers OrderItemModifier[]
  tags               ProductModifierTag[]

  @@map("product_modifiers")
}

// ============================================
// COMBOS
// ============================================

model Combo {
  id            String   @id @default(uuid())
  nameEs        String   @map("name_es")
  nameEn        String?  @map("name_en")
  descriptionEs String?  @map("description_es")
  descriptionEn String?  @map("description_en")
  price         Decimal  @db.Decimal(10, 2)
  image         String?
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  items        ComboItem[]
  orderItems   OrderItem[]
  sectionItems SectionItem[]

  @@map("combos")
}

model ComboItem {
  id        String @id @default(uuid())
  comboId   String @map("combo_id")
  productId String @map("product_id")
  quantity  Int    @default(1)
  sortOrder Int    @default(0) @map("sort_order")

  combo   Combo   @relation(fields: [comboId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("combo_items")
}

// ============================================
// COUPONS
// ============================================

enum CouponType {
  GLOBAL
  UNIQUE
}

model Coupon {
  id              String     @id @default(uuid())
  type            CouponType
  name            String     @unique
  discountPercent Decimal    @map("discount_percent") @db.Decimal(5, 2)
  maxDiscount     Decimal    @map("max_discount") @db.Decimal(10, 2)
  totalQuantity   Int        @map("total_quantity")
  usedQuantity    Int        @default(0) @map("used_quantity")
  expiresAt       DateTime   @map("expires_at")
  isActive        Boolean    @default(true) @map("is_active")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  usages CouponUsage[]
  orders Order[]

  @@map("coupons")
}

model CouponUsage {
  id       String   @id @default(uuid())
  couponId String   @map("coupon_id")
  userId   String   @map("user_id")
  orderId  String   @map("order_id")
  usedAt   DateTime @default(now()) @map("used_at")

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([couponId, userId])
  @@unique([orderId])
  @@map("coupon_usages")
}

// ============================================
// ORDERS
// ============================================

enum OrderStatus {
  PENDING
  PAID
  PARTIAL
  COMPLETED
  CANCELLED
}

model Order {
  id        String      @id @default(uuid())
  userId    String      @map("user_id")
  standId   String?     @map("stand_id")
  couponId  String?     @map("coupon_id")
  status    OrderStatus @default(PENDING)
  qrCode    String      @unique @map("qr_code")
  shortCode String      @unique @map("short_code") @db.VarChar(6)
  subtotal  Decimal     @default(0) @db.Decimal(10, 2)
  discount  Decimal     @default(0) @db.Decimal(10, 2)
  total     Decimal     @default(0) @db.Decimal(10, 2)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  user        User          @relation(fields: [userId], references: [id])
  stand       Stand?        @relation(fields: [standId], references: [id])
  coupon      Coupon?       @relation(fields: [couponId], references: [id])
  items       OrderItem[]
  couponUsage CouponUsage?

  @@index([userId])
  @@map("orders")
}

model OrderItem {
  id            String  @id @default(uuid())
  orderId       String  @map("order_id")
  productId     String  @map("product_id")
  productSizeId String? @map("product_size_id")
  comboId       String? @map("combo_id")
  standId       String? @map("stand_id")
  quantity      Int     @default(1)
  unitPrice     Decimal @map("unit_price") @db.Decimal(10, 2)
  subtotal      Decimal @db.Decimal(10, 2)

  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  productSize ProductSize? @relation(fields: [productSizeId], references: [id], onDelete: Restrict)
  combo       Combo?       @relation(fields: [comboId], references: [id], onDelete: Restrict)
  stand       Stand?       @relation(fields: [standId], references: [id], onDelete: Restrict)
  modifiers   OrderItemModifier[]
  deliveries  OrderItemDelivery[]

  @@index([orderId])
  @@map("order_items")
}

model OrderItemModifier {
  id              String  @id @default(uuid())
  orderItemId     String  @map("order_item_id")
  modifierId      String  @map("modifier_id")
  priceAdjustment Decimal @map("price_adj") @db.Decimal(10, 2)

  orderItem OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  modifier  ProductModifier @relation(fields: [modifierId], references: [id], onDelete: Restrict)

  @@map("order_item_modifiers")
}

model OrderItemDelivery {
  id                String   @id @default(uuid())
  orderItemId       String   @map("order_item_id")
  standId           String   @map("stand_id")
  deliveredByUserId String   @map("delivered_by_user_id")
  deliveredAt       DateTime @default(now()) @map("delivered_at")

  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  stand       Stand     @relation(fields: [standId], references: [id], onDelete: Restrict)
  deliveredBy User      @relation("deliveries", fields: [deliveredByUserId], references: [id], onDelete: Restrict)

  @@map("order_item_deliveries")
}

// ============================================
// BANNERS
// ============================================

model Banner {
  id              String    @id @default(uuid())
  title           String?
  imageUrl        String?   @map("image_url")
  imageMobileUrl  String?   @map("image_mobile_url")
  altText         String    @map("alt_text")
  linkUrl         String?   @map("link_url")
  section         String    @default("home-carousel")
  order           Int       @default(0)
  backgroundColor String?   @map("background_color")
  startDate       DateTime? @map("start_date")
  endDate         DateTime? @map("end_date")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([section, isActive])
  @@map("banners")
}

// ============================================
// MOOD GALLERY
// ============================================

model MoodGallery {
  id             String   @id @default(uuid())
  title          String?
  imageUrl       String?  @map("image_url")
  imageMobileUrl String?  @map("image_mobile_url")
  altEs          String   @map("alt_es")
  altEn          String   @map("alt_en")
  section        String?  @default("mood-carousel")
  order          Int      @default(0)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("mood_gallery")
}

// ============================================
// TAGS
// ============================================

model Tag {
  id        String   @id @default(uuid())
  nameEs    String   @unique @map("name_es")
  nameEn    String?  @map("name_en")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products  ProductTag[]
  modifiers ProductModifierTag[]

  @@map("tags")
}

model ProductTag {
  productId String @map("product_id")
  tagId     String @map("tag_id")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@map("product_tags")
}

model ProductModifierTag {
  modifierId String @map("modifier_id")
  tagId      String @map("tag_id")

  modifier ProductModifier @relation(fields: [modifierId], references: [id], onDelete: Cascade)
  tag      Tag             @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([modifierId, tagId])
  @@map("product_modifier_tags")
}

// ============================================
// SECTIONS
// ============================================

model Section {
  id        String   @id @default(uuid())
  nameEs    String   @map("name_es")
  nameEn    String?  @map("name_en")
  slug      String   @unique
  order     Int      @default(0)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items SectionItem[]

  @@map("sections")
}

model SectionItem {
  id        String  @id @default(uuid())
  sectionId String  @map("section_id")
  productId String? @map("product_id")
  comboId   String? @map("combo_id")
  order     Int     @default(0)

  section Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  combo   Combo?   @relation(fields: [comboId], references: [id], onDelete: Cascade)

  @@unique([sectionId, productId])
  @@unique([sectionId, comboId])
  @@map("section_items")
}