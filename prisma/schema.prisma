generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// USERS
// ============================================

model User {
  id        String   @id @default(uuid())
  authId    String?  @unique @map("auth_id")
  email     String   @unique
  name      String
  phone     String?
  role      Role     @default(USER)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stands     StandOperator[]
  orders     Order[]
  deliveries OrderItemDelivery[] @relation("deliveries")

  @@map("users")
}

enum Role {
  USER
  ADMIN
  STAND_OPERATOR
  CATALOG_MANAGER
}

// ============================================
// STANDS
// ============================================

model Stand {
  id          String   @id @default(uuid())
  name        String
  description String?
  image       String?
  location    String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  operators   StandOperator[]
  products    Product[]
  orders      Order[]
  deliveries  OrderItemDelivery[]

  @@map("stands")
}

model StandOperator {
  standId   String   @map("stand_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  stand Stand @relation(fields: [standId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@id([standId, userId])
  @@map("stand_operators")
}

// ============================================
// PRODUCTS
// ============================================

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  basePrice   Decimal  @map("base_price") @db.Decimal(10, 2)
  image       String?
  stock       Int?
  isActive    Boolean  @default(true) @map("is_active")
  standId     String?  @map("stand_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  stand          Stand?                 @relation(fields: [standId], references: [id])
  sizes          ProductSize[]
  modifierGroups ProductModifierGroup[]
  comboItems     ComboItem[]
  orderItems     OrderItem[]

  @@map("products")
}

model ProductSize {
  id        String  @id @default(uuid())
  productId String  @map("product_id")
  name      String
  price     Decimal @db.Decimal(10, 2)
  stock     Int?
  sortOrder Int     @default(0) @map("sort_order")
  isDefault Boolean @default(false) @map("is_default")
  isActive  Boolean @default(true) @map("is_active")

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@map("product_sizes")
}

model ProductModifierGroup {
  id          String  @id @default(uuid())
  productId   String  @map("product_id")
  name        String
  description String?
  minSelect   Int     @default(0) @map("min_select")
  maxSelect   Int     @default(1) @map("max_select")
  sortOrder   Int     @default(0) @map("sort_order")

  product   Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  modifiers ProductModifier[]

  @@map("product_modifier_groups")
}

model ProductModifier {
  id              String  @id @default(uuid())
  groupId         String  @map("group_id")
  name            String
  priceAdjustment Decimal @default(0) @map("price_adj") @db.Decimal(10, 2)
  isDefault       Boolean @default(false) @map("is_default")
  isActive        Boolean @default(true) @map("is_active")
  sortOrder       Int     @default(0) @map("sort_order")

  group              ProductModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  orderItemModifiers OrderItemModifier[]

  @@map("product_modifiers")
}

// ============================================
// COMBOS
// ============================================

model Combo {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  image       String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  items      ComboItem[]
  orderItems OrderItem[]

  @@map("combos")
}

model ComboItem {
  id        String @id @default(uuid())
  comboId   String @map("combo_id")
  productId String @map("product_id")
  quantity  Int    @default(1)
  sortOrder Int    @default(0) @map("sort_order")

  combo   Combo   @relation(fields: [comboId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("combo_items")
}

// ============================================
// ORDERS
// ============================================

enum OrderStatus {
  PENDING
  PAID
  PARTIAL
  COMPLETED
  CANCELLED
}

model Order {
  id        String      @id @default(uuid())
  userId    String      @map("user_id")
  standId   String?     @map("stand_id")
  status    OrderStatus @default(PENDING)
  qrCode    String      @unique @map("qr_code")
  shortCode String      @unique @map("short_code") @db.VarChar(6)
  total     Decimal     @default(0) @db.Decimal(10, 2)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  user  User   @relation(fields: [userId], references: [id])
  stand Stand? @relation(fields: [standId], references: [id])
  items OrderItem[]

  @@index([userId])
  @@map("orders")
}

model OrderItem {
  id            String  @id @default(uuid())
  orderId       String  @map("order_id")
  productId     String  @map("product_id")
  productSizeId String? @map("product_size_id")
  comboId       String? @map("combo_id")
  quantity      Int     @default(1)
  unitPrice     Decimal @map("unit_price") @db.Decimal(10, 2)
  subtotal      Decimal @db.Decimal(10, 2)

  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  productSize ProductSize? @relation(fields: [productSizeId], references: [id], onDelete: Restrict)
  combo       Combo?       @relation(fields: [comboId], references: [id], onDelete: Restrict)
  modifiers   OrderItemModifier[]
  deliveries  OrderItemDelivery[]

  @@index([orderId])
  @@map("order_items")
}

model OrderItemModifier {
  id              String  @id @default(uuid())
  orderItemId     String  @map("order_item_id")
  modifierId      String  @map("modifier_id")
  priceAdjustment Decimal @map("price_adj") @db.Decimal(10, 2)

  orderItem OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  modifier  ProductModifier @relation(fields: [modifierId], references: [id], onDelete: Restrict)

  @@map("order_item_modifiers")
}

model OrderItemDelivery {
  id                String   @id @default(uuid())
  orderItemId       String   @map("order_item_id")
  standId           String   @map("stand_id")
  deliveredByUserId String   @map("delivered_by_user_id")
  deliveredAt       DateTime @default(now()) @map("delivered_at")

  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  stand       Stand     @relation(fields: [standId], references: [id], onDelete: Restrict)
  deliveredBy User      @relation("deliveries", fields: [deliveredByUserId], references: [id], onDelete: Restrict)

  @@map("order_item_deliveries")
}